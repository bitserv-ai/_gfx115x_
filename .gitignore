.coverage
.tox/
htmlcov/

# Node.js (if any web UI builds)
node_modules/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local utilities / test scripts (DO NOT commit)
*.py
