     // initialized later
     cparams.pipeline_parallel = false;
 
@@ -294,6 +297,26 @@ llama_context::llama_context(
         }
         backends.emplace_back(backend_cpu);
 
+        // SER (Smart Expert Reduction) only has effect on the Vulkan fused topk_moe path.
+        // On CPU/HIP backends, --ser is accepted but has no effect.
+        if (cparams.min_experts > 0) {
+            bool has_vulkan = false;
+            for (auto & backend : backends) {
+                ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+                const char * name = dev ? ggml_backend_dev_name(dev) : nullptr;
+                if (name && strstr(name, "vulkan")) {
+                    has_vulkan = true;
+                    break;
+                }
+            }
+            if (has_vulkan) {
+                cparams.ser_active = true;
+            } else {
+                LLAMA_LOG_WARN("%s: --ser is active (min_experts=%d, thresh=%.2f) but no Vulkan backend found; SER is Vulkan-only and has no effect\n",
+                        __func__, cparams.min_experts, cparams.thresh_experts);
+            }
+        }
+
         // create a list of the set_n_threads functions in the backends
         for (auto & backend : backends) {
