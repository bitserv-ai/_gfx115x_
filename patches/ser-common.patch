+            const std::string thresh_str = value.substr(pos + 1);
+            float thresh = std::stof(thresh_str, &pos_end);
+            if (pos_end != thresh_str.size()) {
+                throw std::invalid_argument("invalid threshold value");
+            }
+            if (kmin < 1) {
+                throw std::invalid_argument("Kmin must be >= 1");
+            }
+            if (!std::isfinite(thresh) || thresh < 0.0f || thresh > 1.0f) {
+                throw std::invalid_argument("threshold must be a finite value in [0.0, 1.0]");
+            }
+            params.min_experts    = kmin;
+            params.thresh_experts = thresh;
+        }
